# You can get a WAVE API key at https://wave.webaim.org/api.
WAVE_KEY=__placeholder__
# AGENT is a local, self-reported label. Kilotest does not trust or publish it: on receiving a
# report, Kilotest overwrites sources.agent with the name it has on file for the authenticated
# worker (see NETWATCH_URL_WORKER_ID below), so this value has no effect on what Kilotest
# publishes. It may still be used by Testaro itself (e.g. in its own local logging).
AGENT=testaro-agent
HEADED_BROWSER=false
DEBUG=false
WAITS=0
NODE_OPTIONS='--trace-uncaught --trace-warnings'
PUPPETEER_DISABLE_HEADLESS_WARNING=true
# Replace the next 2 placeholders with:
# http://localhost:3000 if Kilotest and Testaro are on the same host.
# the URL of the Kilotest server (e.g., https://kilotest.com) if they are on different hosts.
# NOTE: These variable names (NETWATCH_URL_JOB, NETWATCH_URL_REPORT, NETWATCH_URL_AUTH) must
# match what Testaro's netWatch.js actually reads (process.env.NETWATCH_URL_JOB, etc.); a
# previous version of this file used NETWATCH_JOB/NETWATCH_REPORT/NETWATCH_AUTH, which Testaro
# does not read, so network watching would silently fail with those names.
NETWATCH_URL_JOB=__placeholder__/worker/job
NETWATCH_URL_REPORT=__placeholder__/worker/report
# NETWATCH_URL_WORKER_ID must be one of the keys of TESTARO_WORKERS in the Kilotest .env. It is
# used only to authenticate this worker; it is never published, so it need not be, and ideally
# should not be, human-meaningful. (The name published in reports and logs for this worker is
# chosen separately, as the "name" property of this ID's entry in the Kilotest TESTARO_WORKERS
# value.) As of this writing, Testaro's netWatch.js does not yet read this variable or send an
# Authorization header; that requires a pending change to the testaro package.
NETWATCH_URL_WORKER_ID=testaro-worker-1
# NETWATCH_URL_AUTH must be identical to the "secret" property of the NETWATCH_URL_WORKER_ID
# entry in TESTARO_WORKERS in the Kilotest .env. Testaro must send it in an HTTP Basic
# Authorization header, i.e. "Authorization: Basic " followed by the base64 encoding of
# "NETWATCH_URL_WORKER_ID:NETWATCH_URL_AUTH".
NETWATCH_URL_AUTH=__placeholder__
TIMEOUT_MULTIPLIER=1
TMPDIRNAME=scratch
