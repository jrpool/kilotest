# You can get a WAVE API key at https://wave.webaim.org/api.
WAVE_KEY=__placeholder__
AGENT=testaro-agent
HEADED_BROWSER=false
DEBUG=false
WAITS=0
NODE_OPTIONS='--trace-uncaught --trace-warnings'
PUPPETEER_DISABLE_HEADLESS_WARNING=true
# Replace the next 2 placeholders with:
# http://localhost:3000 if Kilotest and Testaro are on the same host.
# the URL of the Kilotest server (e.g., https://kilotest.com) if they are on different hosts.
NETWATCH_JOB=__placeholder__/worker/job
NETWATCH_REPORT=__placeholder__/worker/report
# NETWATCH_WORKER_ID must be one of the keys of TESTARO_WORKERS in the Kilotest .env. It is used
# only to authenticate this worker; it is never published, so it need not be, and ideally should
# not be, human-meaningful. (The name published in reports and logs for this worker is chosen
# separately, as the "name" property of this ID's entry in the Kilotest TESTARO_WORKERS value.)
NETWATCH_WORKER_ID=testaro-worker-1
# NETWATCH_AUTH must be identical to the "secret" property of the NETWATCH_WORKER_ID entry in
# TESTARO_WORKERS in the Kilotest .env. Testaro must send it in an HTTP Basic Authorization
# header, i.e. "Authorization: Basic " followed by the base64 encoding of
# "NETWATCH_WORKER_ID:NETWATCH_AUTH".
NETWATCH_AUTH=__placeholder__
TIMEOUT_MULTIPLIER=1
TMPDIRNAME=scratch
