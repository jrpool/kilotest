# You can get a WAVE API key at https://wave.webaim.org/api.
WAVE_KEY=__placeholder__
# AGENT is a local, self-reported label that Testaro writes into a job's sources.agent property.
# Kilotest neither reads nor alters sources.agent; Kilotest's own record of which worker did the
# job is a separate property, sources.worker, which it sets itself and Testaro never touches.
# This value is therefore purely Testaro's own business (e.g. its local logging); it does not
# need to match, and has no relationship to, any name or ID configured on the Kilotest side.
AGENT=testaro-agent
HEADED_BROWSER=false
DEBUG=false
WAITS=0
NODE_OPTIONS='--trace-uncaught --trace-warnings'
PUPPETEER_DISABLE_HEADLESS_WARNING=true
# Next 2 placeholders are the hostname (e.g., http://localhost:3000 or https://kilotest.com).
# Job request.
NETWATCH_URL_JOB=__placeholder__/worker/job
# Report submission.
NETWATCH_URL_REPORT=__placeholder__/worker/report
# IDs and secrets of all Testaro instances permitted to perform jobs.
TESTARO_WORKERS={"__placeholder__": {"secret": "__placeholder__", "name": "__placeholder"}}
# NETWATCH_URL_WORKER_ID must be one of the keys of TESTARO_WORKERS in the Kilotest .env. It is
# used only to authenticate this worker; it is never published, so it need not be, and ideally
# should not be, human-meaningful. (The name Kilotest publishes and logs for this worker, in
# sources.worker, is chosen separately, as the "name" property of this ID's entry in the
# Kilotest TESTARO_WORKERS value.) As of this writing, Testaro's netWatch.js does not yet read
# this variable or send an Authorization header; that requires a pending change to the testaro
# package. That change does not need to touch AGENT or sources.agent at all.
NETWATCH_WORKER_ID=__placeholder__
# NETWATCH_URL_AUTH must be identical to the "secret" property of the NETWATCH_URL_WORKER_ID
# entry in TESTARO_WORKERS in the Kilotest .env. Testaro must send it in an HTTP Basic
# Authorization header, i.e. "Authorization: Basic " followed by the base64 encoding of
# "NETWATCH_URL_WORKER_ID:NETWATCH_URL_AUTH".
NETWATCH_URL_AUTH=__placeholder__
TIMEOUT_MULTIPLIER=1
TMPDIRNAME=scratch
