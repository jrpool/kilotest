{
  "name": "@jrpool/kilotest",
  "version": "46.0.13",
  "description": "Ensemble testing for front-end web quality",
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node index",
    "lint": "npx eslint && npx markdownlint-cli2",
    "test": "c8 node --require ./test/setup.cjs --test --test-concurrency=1 --test-timeout=70",
    "test:smoke": "node smokeTest",
    "generate:openapi": "node scripts/generate-openapi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jrpool/kilotest"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "testing",
    "mcp",
    "mcp-server",
    "modelcontextprotocol"
  ],
  "author": "Jonathan Robert Pool <pool@jpdev.pro>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jrpool/kilotest/issues",
    "email": "info@kilotest.com"
  },
  "homepage": "https://github.com/jrpool/kilotest",
  "dependencies": {
    "@modelcontextprotocol/sdk": "*",
    "dotenv": "*",
    "testaro-issues": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@eslint/css": "*",
    "@eslint/js": "*",
    "@eslint/json": "*",
    "@eslint/markdown": "*",
    "@redocly/cli": "*",
    "c8": "*",
    "eslint": "*",
    "globals": "*",
    "js-yaml": "*",
    "markdownlint-cli2": "*",
    "node-html-parser": "*",
    "zod-openapi": "*"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  },
  "c8": {
    "all": true,
    "reporter": [
      "text",
      "html"
    ],
    "include": [
      "index.js",
      "mcp.js",
      "alerts.js",
      "util.js",
      "api/**/*.js",
      "web/**/*.js"
    ],
    "exclude": [
      "coverage/**",
      "test{,s}/**",
      "test{,-*}.{js,cjs,mjs}",
      "**/*{.,-}test.{js,cjs,mjs}",
      "**/__tests__/**",
      "scripts/**"
    ],
    "check-coverage": true,
    "lines": 100,
    "statements": 100,
    "functions": 100,
    "branches": 100
  }
}
