{
  "name": "@jrpool/kilotest",
  "version": "46.1.3",
  "description": "Ensemble testing for front-end web quality",
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "start": "node index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint && out=$(npx markdownlint-cli2 2>&1); code=$?; if [ $code -ne 0 ]; then echo \"$out\"; exit $code; fi",
    "test": "c8 node --require ./test/setup.ts --experimental-test-module-mocks --test --test-concurrency=1 --test-randomize '**/*.test.ts'",
    "test:smoke": "node smokeTest.ts",
    "checkinfo": "node checkinfo.ts",
    "generate:openapi": "node scripts/generate-openapi.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jrpool/kilotest"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "testing",
    "mcp",
    "mcp-server",
    "modelcontextprotocol"
  ],
  "author": "Jonathan Robert Pool <pool@jpdev.pro>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jrpool/kilotest/issues",
    "email": "info@kilotest.com"
  },
  "homepage": "https://github.com/jrpool/kilotest",
  "dependencies": {
    "@modelcontextprotocol/sdk": "*",
    "dotenv": "*",
    "testaro-issues": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@eslint/css": "*",
    "@eslint/js": "*",
    "@eslint/json": "*",
    "@eslint/markdown": "*",
    "@redocly/cli": "*",
    "@types/node": "*",
    "c8": "*",
    "eslint": "*",
    "globals": "*",
    "js-yaml": "*",
    "markdownlint-cli2": "*",
    "node-html-parser": "*",
    "typescript": "*",
    "zod-openapi": "*"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  },
  "c8": {
    "all": true,
    "extension": [
      ".js",
      ".cjs",
      ".mjs",
      ".ts",
      ".tsx",
      ".jsx",
      ".cts",
      ".mts"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "include": [
      "index.ts",
      "mcp.ts",
      "alerts.ts",
      "util.ts",
      "api/**/*.{js,ts,cts}",
      "web/**/*.{js,ts,cts}"
    ],
    "exclude": [
      "coverage/**",
      "test{,s}/**",
      "test{,-*}.{js,cjs,mjs}",
      "**/*{.,-}test.{js,cjs,mjs,ts}",
      "**/__tests__/**",
      "scripts/**"
    ],
    "check-coverage": true,
    "lines": 100,
    "statements": 100,
    "functions": 100,
    "branches": 100
  }
}
